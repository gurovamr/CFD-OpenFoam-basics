FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

radius      0.45;
box         0.18;
z0          0;
z1          9;

xc0         0.00;
xc1         0.62;

yc0         0.00;
yc1         0.08;

nA          36;
nB          10;
nR          12;

boxNeg      #neg $box;
rDiag       0.3181980515;
rDiagNeg    #neg $rDiag;

vertices
(
    // inlet section
    (#calc "$xc0+$boxNeg" #calc "$yc0+$boxNeg" $z0)
    (#calc "$xc0+$box"    #calc "$yc0+$boxNeg" $z0)
    (#calc "$xc0+$boxNeg" #calc "$yc0+$box"    $z0)
    (#calc "$xc0+$box"    #calc "$yc0+$box"    $z0)

    (#calc "$xc0+$rDiagNeg" #calc "$yc0+$rDiagNeg" $z0)
    (#calc "$xc0+$rDiag"    #calc "$yc0+$rDiagNeg" $z0)
    (#calc "$xc0+$rDiagNeg" #calc "$yc0+$rDiag"    $z0)
    (#calc "$xc0+$rDiag"    #calc "$yc0+$rDiag"    $z0)

    // outlet section
    (#calc "$xc1+$boxNeg" #calc "$yc1+$boxNeg" $z1)
    (#calc "$xc1+$box"    #calc "$yc1+$boxNeg" $z1)
    (#calc "$xc1+$boxNeg" #calc "$yc1+$box"    $z1)
    (#calc "$xc1+$box"    #calc "$yc1+$box"    $z1)

    (#calc "$xc1+$rDiagNeg" #calc "$yc1+$rDiagNeg" $z1)
    (#calc "$xc1+$rDiag"    #calc "$yc1+$rDiagNeg" $z1)
    (#calc "$xc1+$rDiagNeg" #calc "$yc1+$rDiag"    $z1)
    (#calc "$xc1+$rDiag"    #calc "$yc1+$rDiag"    $z1)
);

blocks
(
    hex ( 4  5  1  0 12 13  9  8) ($nB $nR $nA) simpleGrading (1 1 1)
    hex ( 4  0  2  6 12  8 10 14) ($nR $nB $nA) simpleGrading (1 1 1)
    hex ( 1  5  7  3  9 13 15 11) ($nR $nB $nA) simpleGrading (1 1 1)
    hex ( 2  3  7  6 10 11 15 14) ($nB $nR $nA) simpleGrading (1 1 1)
    hex ( 0  1  3  2  8  9 11 10) ($nB $nB $nA) simpleGrading (1 1 1)
);

edges
(
    // circular outer edges on inlet
    arc  4  5 ($xc0 #calc "$yc0-$radius" $z0)
    arc  5  7 (#calc "$xc0+$radius" $yc0 $z0)
    arc  7  6 ($xc0 #calc "$yc0+$radius" $z0)
    arc  6  4 (#calc "$xc0-$radius" $yc0 $z0)

    // circular outer edges on outlet
    arc 12 13 ($xc1 #calc "$yc1-$radius" $z1)
    arc 13 15 (#calc "$xc1+$radius" $yc1 $z1)
    arc 15 14 ($xc1 #calc "$yc1+$radius" $z1)
    arc 14 12 (#calc "$xc1-$radius" $yc1 $z1)

    // curved centerline effect through axial arcs
    arc  0  8 (#calc "0.5*($xc0+$xc1)-0.16" #calc "0.5*($yc0+$yc1)-0.06" 4.5)
    arc  1  9 (#calc "0.5*($xc0+$xc1)+0.20" #calc "0.5*($yc0+$yc1)-0.06" 4.5)
    arc  2 10 (#calc "0.5*($xc0+$xc1)-0.16" #calc "0.5*($yc0+$yc1)+0.30" 4.5)
    arc  3 11 (#calc "0.5*($xc0+$xc1)+0.20" #calc "0.5*($yc0+$yc1)+0.30" 4.5)
    arc  4 12 (#calc "0.5*($xc0+$xc1)-$rDiag" #calc "0.5*($yc0+$yc1)-$rDiag" 4.5)
    arc  5 13 (#calc "0.5*($xc0+$xc1)+$rDiag" #calc "0.5*($yc0+$yc1)-$rDiag" 4.5)
    arc  6 14 (#calc "0.5*($xc0+$xc1)-$rDiag" #calc "0.5*($yc0+$yc1)+$rDiag" 4.5)
    arc  7 15 (#calc "0.5*($xc0+$xc1)+$rDiag" #calc "0.5*($yc0+$yc1)+$rDiag" 4.5)
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (4 5 1 0)
            (4 0 2 6)
            (1 5 7 3)
            (2 3 7 6)
            (0 1 3 2)
        );
    }

    outlet
    {
        type patch;
        faces
        (
            (12 13  9  8)
            (12  8 10 14)
            (9 13 15 11)
            (10 11 15 14)
            (8  9 11 10)
        );
    }

    walls
    {
        type wall;
        faces
        (
            (4 5 13 12)
            (5 7 15 13)
            (7 6 14 15)
            (6 4 12 14)
        );
    }
);


